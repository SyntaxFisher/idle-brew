#!/usr/bin/env bash
# Launcher for idle-typing. On first run it sets everything up on a fresh
# machine: creates a local venv and installs dependencies. Safe to symlink
# onto your PATH ("./idle install" does that for you).
set -euo pipefail

DIR="$(dirname "$(readlink -f "$0")")"
VENV="$DIR/.venv"

if ! command -v python3 >/dev/null 2>&1; then
    echo "error: python3 not found. Install it with: brew install python3 (or: xcode-select --install)" >&2
    exit 1
fi

install_global() {
    for target in /opt/homebrew/bin /usr/local/bin; do
        if [ -d "$target" ] && [ -w "$target" ]; then
            ln -sf "$DIR/idle" "$target/idle"
            echo "Installed: $target/idle -> $DIR/idle"
            echo "You can now run 'idle' from anywhere."
            return 0
        fi
    done
    echo "warning: could not install global 'idle' command (no writable dir among /opt/homebrew/bin, /usr/local/bin)" >&2
    return 1
}

if [ ! -x "$VENV/bin/python" ]; then
    echo "First run: creating virtualenv and installing dependencies..."
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install --quiet --upgrade pip
    "$VENV/bin/pip" install --quiet -r "$DIR/requirements.txt"
    install_global || true
    echo "Setup complete."
fi

if [ "${1:-}" = "install" ]; then
    install_global
    exit $?
fi

exec "$VENV/bin/python" "$DIR/script.py" "$@"
